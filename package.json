{
  "name": "lilybeta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"BACKEND_PORT=3006 tsx watch server/index.ts\" \"BACKEND_PORT=3006 CLIENT_PORT=3005 vite\"",
    "dev:server": "BACKEND_PORT=3006 tsx watch server/index.ts",
    "dev:client": "BACKEND_PORT=3006 CLIENT_PORT=3005 vite",
    "server": "BACKEND_PORT=3006 tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate": "tsx server/migrations/runner.ts",
    "test:security": "tsx tests/idor-security.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
