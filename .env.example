# Server Port
PORT=3006
BACKEND_PORT=3006
CLIENT_PORT=3005

# JWT Secret (MUST be configured with a random secure string in production)
JWT_SECRET=your-strong-random-jwt-secret-min-32-chars

# Database Path (Local SQLite)
DB_PATH=./data/lilybeta.db

# Environment (development | production)
NODE_ENV=development

# Admin Bootstrap (Set to true only during initial setup in production)
BOOTSTRAP_ADMIN=false
